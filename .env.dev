# 数据库选项
DEMO_DB_DB_TYPE=MySQL

# MYSQL数据库配置
DEMO_DB_MYSQL_HOST=192.168.1.245
DEMO_DB_MYSQL_PORT=3308
DEMO_DB_MYSQL_USER=root
DEMO_DB_MYSQL_PASSWORD=XZY@12345
DEMO_DB_MYSQL_DB=XZY_DEMO

# PostgreSQL数据库配置
DEMO_DB_PG_HOST=localhost
DEMO_DB_PG_PORT=5432
DEMO_DB_PG_USER=root
DEMO_DB_PG_PASSWORD=yqb12345
DEMO_DB_PG_DB=XZY_DEMO

# 连接池配置 (仅 Postgres 有效)
# --- 必选参数：中等并发常用 ---
DEMO_DB_POOL_SIZE=20
DEMO_DB_MAX_OVERFLOW=10
DEMO_DB_POOL_TIMEOUT=30
DEMO_DB_POOL_PRE_PING=True

# --- 可选调优参数（高级场景） ---
DEMO_DB_POOL_RECYCLE=3600
DEMO_DB_POOL_USE_LIFO=False
DEMO_DB_ECHO=False

# FastAPI设置
DEMO_APP_NAME=FastAPI_DEMO_DEV
DEMO_APP_VERSION=0.1.0_DEV
DEMO_DEBUG=True